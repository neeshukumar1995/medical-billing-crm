  table.info td { border:1px solid #ccc; padding:8pt 10pt; font-size:11pt; }
  table.info td.k { background:#eef2fb; font-weight:bold; width:35%; }
  .badge { display:inline-block; background:#eef2fb; color:#1f3a7a; padding:3pt 10pt; border-radius:10pt; font-size:10pt; font-weight:bold; margin-bottom:10pt; }
  .status-active { color:#17c666; font-weight:bold; }
  .status-inactive { color:#6c757d; font-weight:bold; }
  .status-suspended { color:#dc3545; font-weight:bold; }
  hr.page-break { page-break-before: always; border:none; }
