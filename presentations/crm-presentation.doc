<style>
  @page { size: 21cm 29.7cm; margin: 2.5cm; }
  body { font-family: Calibri, Arial, sans-serif; font-size: 12pt; color:#1a1a1a; line-height:1.5; }
  h1.title { font-size: 30pt; color:#1f3a7a; margin-bottom:4pt; }
  h2.subtitle { font-size:14pt; color:#555; font-weight:normal; margin-top:0; }
  h1.section { font-size:18pt; color:#1f3a7a; border-bottom:2px solid #4f7cff; padding-bottom:4pt; margin-top:32pt; }
  h2.section { font-size:14pt; color:#2a4a9c; margin-top:18pt; }
  p { margin:8pt 0; }
  ul { margin:8pt 0; padding-left:22pt; }
  li { margin-bottom:6pt; }
